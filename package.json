{
  "name": "stokmate",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=11.24.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "generate": "turbo run generate",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "smoke:api": "turbo run smoke:api --filter=@stokmate/smoke",
    "smoke:contract": "turbo run smoke:contract --filter=@stokmate/smoke"
  },
  "devDependencies": {
    "pnpm": "11.24.0",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "turbo": "2.7.4"
  }
}
