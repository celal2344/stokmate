{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "bin/**", "!bin/**/ref/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck", "generate"]
    },
    "generate": {
      "outputs": ["src/generated/**"]
    },
    "smoke:api": {
      "cache": false,
      "env": [
        "STOKMATE_API_BASE_URL",
        "STOKMATE_TEST_EMAIL",
        "STOKMATE_TEST_PASSWORD"
      ]
    },
    "smoke:contract": {
      "cache": false,
      "env": ["STOKMATE_API_BASE_URL"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
