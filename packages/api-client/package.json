{
  "name": "@stokmate/api-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "generate": "orval --config orval.config.ts",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json --resolve-full-paths --resolve-full-extension .js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@stokmate/eslint-config": "workspace:*",
    "@stokmate/typescript-config": "workspace:*",
    "eslint": "9.35.0",
    "orval": "8.26.0",
    "tsc-alias": "1.9.2",
    "typescript": "5.9.2"
  }
}
